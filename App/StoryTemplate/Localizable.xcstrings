    "%@ ile hikâye videolarını dakikalar içinde hazırlıyorum:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I create story videos in minutes with %@:"
