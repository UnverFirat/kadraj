<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- İzleme YOK: uygulama reklam ağlarına veri göndermiyor, cihazlar arası
	     eşleştirme yapmıyor, üçüncü parti SDK barındırmıyor. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Toplanan veri YOK. Analitik olayları şu an yalnız cihazda tutuluyor
	     (bellekte, Ayarlar'daki debug listesi); hiçbir sunucuya gitmiyor,
	     kimlik/PII taşımıyor. Ürün analitiği sağlayıcısı bağlandığında bu
	     bölüme "Product Interaction" (kimlikle ilişkilendirilmemiş, izleme
	     amaçlı değil) girişi eklenmeli ve App Store Connect gizlilik formu
	     birlikte güncellenmeli. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- "Required reason" API'leri. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults: abonelik durumu önbelleği (EntitlementCache) ve
			     kullanıcı tercihleri. Yalnız bu uygulamanın kendi verisi. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Dosya zaman damgaları: "Videolarım" listesindeki export'ların
			     tarihi kullanıcıya gösteriliyor ve sıralamada kullanılıyor. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>DDA9.1</string>
			</array>
		</dict>
		<dict>
			<!-- Boş disk alanı: export öncesi yer kontrolü (yarım kalan
			     export yerine anlaşılır uyarı). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
