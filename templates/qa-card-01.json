      "key": "qLabel",
      "default": {
        "en": "QUESTION",
        "tr": "SORU"
      },
      "font": {
        "name": "AvenirNext-DemiBold",
        "size": 0.02
      },
      "colorRole": "accent",
      "alignment": "center",
      "letterSpacing": 0.012,
      "allCaps": true
    },
    {
      "id": "question",
