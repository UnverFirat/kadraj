        "name": "AvenirNext-Bold",
        "size": 0.042
      },
      "colorRole": "background",
      "alignment": "center",
      "maxLines": 3
    },
    {
      "id": "answer",
      "frame": {
        "x": 0.5,
        "y": 0.66,
        "width": 0.82,
        "height": 0.26
