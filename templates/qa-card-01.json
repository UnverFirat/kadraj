      "type": "text",
      "key": "answerText",
      "default": {
        "en": "With a small phone\nand a lot of curiosity.",
        "tr": "Küçük bir telefonla\nve çok merakla."
      },
      "font": {
        "name": "AvenirNext-Medium",
        "size": 0.038
      },
      "colorRole": "textOnAccent",
      "alignment": "center",
      "maxLines": 3
    },
    {
      "id": "invite",
      "frame": {
        "x": 0.5,
        "y": 0.88,
        "width": 0.72,
        "height": 0.04
      },
      "timing": {
        "start": 1.3
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.6
        }
      ],
      "type": "text",
      "key": "invite",
      "default": {
        "en": "Send me your questions",
        "tr": "Sorularınızı bekliyorum"
      },
      "font": {
        "name": "AvenirNext-Regular",
        "size": 0.021
      },
      "colorRole": "textPrimary",
      "alignment": "center"
    }
