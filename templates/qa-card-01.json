{
  "schemaVersion": 2,
  "id": "qa-card-01",
  "name": {
    "en": "Q&A",
    "tr": "Soru-Cevap"
  },
  "category": "social",
  "isPro": false,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "palette": {
    "background": "#160B2B",
    "surface": "#FFFFFF",
    "accent": "#B06BFF",
    "textPrimary": "#F6F0FF",
    "textSecondary": "#B9A9D4",
    "textOnAccent": "#FFFFFF",
    "scrimClear": "#00000000",
    "scrimSolid": "#000000CC"
  },
  "audio": {
    "defaultTrackId": "smooth-01",
    "volume": 0.85
  },
  "layers": [
    {
      "id": "veil",
      "frame": {
        "x": 0.5,
        "y": 0.5,
        "width": 1.0,
        "height": 1.0
      },
      "type": "shape",
      "colorRole": "scrimClear",
      "gradient": {
        "from": "scrimClear",
        "to": "scrimSolid",
        "direction": "up"
      }
    },
    {
      "id": "bubble",
      "frame": {
        "x": 0.5,
        "y": 0.34,
        "width": 0.82,
        "height": 0.24
      },
      "animations": [
        {
          "role": "in",
          "preset": "scaleIn",
          "duration": 0.55,
          "easing": "easeOut",
          "params": {
            "from": 0.9
          }
        }
      ],
      "type": "shape",
      "colorRole": "surface",
      "cornerRadius": 0.06
    },
    {
      "id": "tail",
      "frame": {
        "x": 0.3,
        "y": 0.47,
        "width": 0.06,
        "height": 0.034
      },
      "rotation": 45,
      "animations": [
        {
          "role": "in",
          "preset": "scaleIn",
          "duration": 0.4,
          "delay": 0.2,
          "easing": "easeOut",
          "params": {
            "from": 0.6
          }
        }
      ],
      "type": "shape",
      "colorRole": "surface"
    },
    {
      "id": "q-label",
      "frame": {
        "x": 0.5,
        "y": 0.255,
        "width": 0.5,
        "height": 0.035
