      "type": "shape",
      "colorRole": "scrimClear",
      "gradient": {
        "from": "scrimClear",
        "to": "scrimSolid",
        "direction": "down"
      }
    },
    {
      "id": "terms",
      "frame": {
        "x": 0.5,
        "y": 0.1,
        "width": 0.86,
        "height": 0.04
      },
      "timing": {
        "start": 0.25
      },
      "animations": [
        {
          "role": "in",
          "preset": "typewriter",
          "duration": 1.0
        }
      ],
      "type": "text",
      "key": "terms",
      "default": {
        "en": "FULL-TIME · HYBRID",
        "tr": "TAM ZAMANLI · İSTANBUL"
      },
      "font": {
        "name": "AvenirNext-DemiBold",
        "size": 0.022
      },
      "colorRole": "accent",
      "alignment": "center",
      "letterSpacing": 0.016,
      "allCaps": true
    },
    {
      "id": "headline",
      "frame": {
        "x": 0.5,
        "y": 0.715,
        "width": 0.86,
        "height": 0.18
      },
      "timing": {
        "start": 0.6
      },
      "animations": [
        {
          "role": "in",
          "preset": "kineticWords",
          "duration": 0.9,
          "params": {
            "distance": 0.02
          }
        },
        {
          "role": "loop",
          "preset": "floatLoop",
          "duration": 2.6,
          "params": {
            "distance": 0.006,
            "axis": "y"
          }
        }
      ],
      "type": "text",
      "key": "headline",
      "default": {
        "en": "JOIN OUR\nTEAM",
        "tr": "EKİBİMİZE\nKATIL"
