      "colorRole": "textPrimary",
      "alignment": "center",
      "maxLines": 2,
      "allCaps": true
    },
    {
      "id": "chip",
      "frame": {
        "x": 0.5,
        "y": 0.855,
        "width": 0.66,
        "height": 0.085
