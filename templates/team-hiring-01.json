{
  "schemaVersion": 1,
  "id": "team-hiring-01",
  "name": {
    "en": "We're Hiring",
    "tr": "İş İlanı"
  },
  "category": "business",
  "isPro": false,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "duration": 6.5,
  "palette": {
    "background": "#1B0F1E",
    "surface": "#FFF3E9",
    "accent": "#FF7A45",
    "textPrimary": "#FFF3E9",
    "textSecondary": "#D3AFA0",
    "textOnAccent": "#FFFFFF",
    "scrimClear": "#00000000",
    "scrimSolid": "#000000CC"
