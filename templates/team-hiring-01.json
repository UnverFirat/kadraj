  "audio": {
    "defaultTrackId": "upbeat-01",
    "volume": 0.85
  },
  "layers": [
    {
      "id": "bg",
      "frame": {
        "x": 0.5,
        "y": 0.5,
        "width": 1.0,
        "height": 1.0
      },
      "type": "shape",
      "colorRole": "background"
    },
    {
      "id": "photo",
      "frame": {
        "x": 0.5,
        "y": 0.5,
        "width": 1.0,
        "height": 1.0
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.5
        },
        {
          "role": "loop",
          "preset": "kenBurns",
          "duration": 6.5,
          "params": {
            "zoom": 1.1,
            "direction": "up"
          }
        }
      ],
      "type": "mediaSlot",
      "slotIndex": 0,
      "media": "photoOrVideo",
      "contentMode": "fill",
      "mask": "rect",
      "filter": "warm",
      "filterIntensity": 0.4
    },
    {
      "id": "scrim-top",
      "frame": {
        "x": 0.5,
        "y": 0.12,
        "width": 1.0,
        "height": 0.24
      },
      "type": "shape",
      "colorRole": "scrimClear",
      "gradient": {
        "from": "scrimClear",
        "to": "scrimSolid",
        "direction": "up"
      }
    },
    {
      "id": "scrim-bottom",
      "frame": {
        "x": 0.5,
        "y": 0.5,
        "width": 1.0,
        "height": 1.0
