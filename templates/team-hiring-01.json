      "timing": {
        "start": 1.1
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.4
        }
      ],
      "type": "text",
      "key": "role",
      "default": {
        "en": "Senior Graphic Designer",
        "tr": "Kıdemli Grafik Tasarımcı"
      },
      "font": {
        "name": "AvenirNext-Bold",
        "size": 0.028
      },
      "colorRole": "textOnAccent",
      "alignment": "center"
    },
    {
      "id": "apply",
      "frame": {
        "x": 0.5,
        "y": 0.935,
        "width": 0.86,
        "height": 0.04
      },
      "timing": {
        "start": 1.2
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.6
        }
      ],
      "type": "text",
      "key": "apply",
      "default": {
        "en": "Apply: careers@studio.com",
        "tr": "Başvuru: kariyer@sirket.com"
      },
      "font": {
        "name": "AvenirNext-Regular",
        "size": 0.021
      },
      "colorRole": "textSecondary",
      "alignment": "center"
    }
  ]
}
