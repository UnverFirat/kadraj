      "timing": {
        "start": 0.3
      },
      "animations": [
        {
          "role": "in",
          "preset": "wipeReveal",
          "duration": 0.7,
          "easing": "easeOut",
          "params": {
            "direction": "right"
          }
        }
      ],
      "type": "shape",
      "colorRole": "surface"
