    {
      "id": "veil",
      "frame": {
        "x": 0.5,
        "y": 0.78,
        "width": 1.0,
        "height": 0.44
      },
      "type": "shape",
      "colorRole": "scrimClear",
      "gradient": {
        "from": "scrimClear",
        "to": "scrimSolid",
        "direction": "down"
      }
    },
    {
      "id": "edge-top",
      "frame": {
        "x": 0.5,
        "y": 0.07,
        "width": 0.84,
        "height": 0.0035
