      "timing": {
        "start": 0.5
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.7
        }
      ],
      "type": "shape",
      "colorRole": "surface"
    },
    {
      "id": "edge-right",
      "frame": {
        "x": 0.92,
        "y": 0.5,
        "width": 0.002,
        "height": 0.86
      },
      "timing": {
        "start": 0.5
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.7
        }
      ],
      "type": "shape",
      "colorRole": "surface"
    },
    {
      "id": "caption",
      "frame": {
        "x": 0.5,
        "y": 0.83,
        "width": 0.74,
        "height": 0.13
      },
      "timing": {
        "start": 0.75
      },
      "animations": [
        {
          "role": "in",
