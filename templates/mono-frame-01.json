{
  "schemaVersion": 1,
  "id": "mono-frame-01",
  "name": {
    "en": "Mono Frame",
    "tr": "Siyah Beyaz"
  },
  "category": "minimal",
  "isPro": false,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "duration": 6.5,
  "palette": {
    "background": "#0A0A0A",
    "surface": "#FFFFFF",
    "accent": "#FFFFFF",
    "textPrimary": "#FFFFFF",
    "textSecondary": "#9A9A9A",
    "textOnAccent": "#0A0A0A",
    "scrimClear": "#00000000",
    "scrimSolid": "#000000CC"
  },
  "audio": {
    "defaultTrackId": "ambient-01",
    "volume": 0.85
  },
  "layers": [
    {
      "id": "bg",
      "frame": {
        "x": 0.5,
        "y": 0.5,
        "width": 1.0,
        "height": 1.0
      },
      "type": "shape",
      "colorRole": "background"
    },
    {
      "id": "shot",
      "frame": {
        "x": 0.5,
        "y": 0.5,
        "width": 1.0,
        "height": 1.0
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.8
        },
        {
          "role": "loop",
          "preset": "kenBurns",
          "duration": 6.5,
          "params": {
            "zoom": 1.07,
            "direction": "up"
          }
        }
      ],
      "type": "mediaSlot",
      "slotIndex": 0,
      "media": "photoOrVideo",
      "contentMode": "fill",
      "mask": "rect",
      "filter": "mono",
      "filterIntensity": 1.0
