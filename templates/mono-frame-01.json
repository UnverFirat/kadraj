      "timing": {
        "start": 1.15
      },
      "animations": [
        {
          "role": "in",
          "preset": "fadeIn",
          "duration": 0.6
        }
      ],
      "type": "text",
      "key": "date",
      "default": {
        "en": "AUGUST 10, 2026",
        "tr": "10 AĞUSTOS 2026"
      },
      "font": {
        "name": "AvenirNext-Medium",
        "size": 0.019
      },
      "colorRole": "textSecondary",
      "alignment": "center",
      "letterSpacing": 0.014,
      "allCaps": true
    }
