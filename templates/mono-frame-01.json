          "easing": "easeOut",
          "params": {
            "direction": "left"
          }
        }
      ],
      "type": "shape",
      "colorRole": "surface"
    },
    {
      "id": "edge-left",
      "frame": {
        "x": 0.08,
        "y": 0.5,
        "width": 0.002,
        "height": 0.86
