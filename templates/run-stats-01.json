{
  "schemaVersion": 1,
  "id": "run-stats-01",
  "name": {
    "en": "Run Stats",
    "tr": "Koşu Kartı"
  },
  "category": "fitness",
  "isPro": false,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "duration": 6.0,
  "palette": {
    "background": "#0B0B12",
    "surface": "#FFFFFF",
    "accent": "#6C8CFF",
    "textPrimary": "#F4F5FF",
