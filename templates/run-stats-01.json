        {
          "role": "loop",
          "preset": "kenBurns",
          "duration": 6.0,
          "params": {
            "zoom": 1.12,
            "direction": "down"
          }
        }
      ],
      "type": "mediaSlot",
      "slotIndex": 0,
      "media": "photoOrVideo",
      "contentMode": "fill",
      "mask": "rect",
      "filter": "cool",
      "filterIntensity": 0.45
