# Derleme çıktıları
App/build/
TemplateKit/.build/
demo-output/
DerivedData/

# ÜRETİLEN vitrin medyası — depoya girmez, tek komutla yeniden üretilir:
#   cd TemplateKit && swift run -c release templatekit-assets --make-samples
#   swift run -c release templatekit-assets        (+ --lang en)
# Posterler (templates/thumbs) İSTİSNA: uygulama paketine seed olarak giriyor,
# bu yüzden depoda tutuluyor. Önizleme videoları (139 MB) CDN'e gider.
templates/previews/
tools/samples/*.mp4
tools/contact/
# Fotoğraf havuzu elemesi: indirilen adaylar (280 MB). Seçilenler
# tools/samples/source/ altına taşınır ve ORAYA girer.
tools/samples/candidates/
# ...ama ELEME KARARI depoda kalır: hangi adayın vitrine girdiğini yalnız bu
# dosya söylüyor ve `--promote` onu okuyor. Kaybolursa 133 adayın gözle
# elenmesi baştan yapılır.
!tools/samples/candidates/ACCEPTED.txt


# Xcode kullanıcı durumu (paylaşılan scheme'ler xcshareddata'da, o kalır)
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

.DS_Store

# Kişisel Claude Code ayarları (paylaşılan settings.json kalır)
.claude/settings.local.json

# Python derleme artıkları (tools/ betikleri import edilirken oluşuyor)
__pycache__/
*.pyc
